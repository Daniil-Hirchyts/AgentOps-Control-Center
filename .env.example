# ---- Database ----
DATABASE_URL=postgres://agentops:agentops@localhost:5432/agentops
POSTGRES_USER=agentops
POSTGRES_PASSWORD=agentops
POSTGRES_DB=agentops

# ---- HTTP server ----
BIND_ADDR=0.0.0.0:8080
# Comma-separated extra allowed browser origins (same-host origins are always allowed)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RUST_LOG=agentops=info,tower_http=info

# ---- Auth (generate with: openssl rand -base64 48) ----
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-bytes
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
WS_TICKET_TTL_SECONDS=30
COOKIE_SECURE=false

# ---- LLM (LM Studio, OpenAI-compatible) ----
LLM_PROVIDER=lmstudio
LLM_BASE_URL=http://localhost:1234/v1
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=120
# real | mock
LLM_MODE=mock
